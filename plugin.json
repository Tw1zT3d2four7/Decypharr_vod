{
  "name": "Decypharr VOD",
  "version": "1.0.6",
  "description": "v1.0.6: Native Dispatcharr VOD for Decypharr with one canonical relation per media item, source-identity continuity across title/path renames, and optional season-continuous playback metadata.",
  "author": "Tw1zT3d2four7",
  "fields": [
    {"id":"api_url","label":"Decypharr API URL","type":"string","default":"http://192.168.1.11:8282"},
    {"id":"api_token","label":"Decypharr API Token","type":"string","default":""},
    {"id":"library_root","label":"Normalized Library","type":"string","default":"/data/plugins/decypharr_vod/library"},
    {"id":"tmdb_api_key","label":"TMDB API Key","type":"string","default":""},
    {"id":"metadata_enabled","label":"TMDB Metadata","type":"boolean","default":true},
    {"id":"ffprobe_path","label":"FFprobe Path","type":"string","default":"/usr/local/bin/ffprobe"},
    {"id":"preferred_audio_language","label":"Preferred Audio Language","type":"select","default":"eng","options":[{"value":"eng","label":"English"},{"value":"spa","label":"Spanish"},{"value":"fra","label":"French"},{"value":"deu","label":"German"},{"value":"ita","label":"Italian"},{"value":"por","label":"Portuguese"},{"value":"jpn","label":"Japanese"},{"value":"kor","label":"Korean"},{"value":"zho","label":"Chinese"},{"value":"hin","label":"Hindi"},{"value":"ara","label":"Arabic"},{"value":"original","label":"Source Default / First Available"}]},
    {"id":"scan_interval","label":"Auto Scan Interval (seconds)","type":"number","default":60},
    {"id":"fast_initial_scan","label":"Fast Initial Scan","type":"boolean","default":true},
    {"id":"metadata_batch_size","label":"Metadata Enrichment Batch Size","type":"number","default":10},
    {"id":"progressive_batch_size","label":"Progressive Import Batch Size","type":"number","default":200},
    {"id":"api_workers","label":"Decypharr API Workers","type":"number","default":4},
    {"id":"continuous_season_playback","label":"Continuous Season Playback","type":"boolean","default":false,"help_text":"Expose ordered next-episode metadata for automatic playback from Season 1 Episode 1 through the last episode of that season. Season boundaries stop automatic progression."},
    {"id":"browser_transcode","label":"Browser Transcoding","type":"boolean","default":false},
    {"id":"transcode_encoder","label":"Transcode Encoder","type":"select","default":"auto","options":[{"value":"auto","label":"Auto-detect"},{"value":"nvenc","label":"NVIDIA NVENC"},{"value":"qsv","label":"Intel Quick Sync"},{"value":"vaapi","label":"AMD / Intel VAAPI"},{"value":"cpu","label":"CPU libx264"}]},
    {"id":"vaapi_device","label":"VAAPI / QSV Render Device","type":"string","default":"/dev/dri/renderD128"},
    {"id":"ffmpeg_path","label":"FFmpeg Path","type":"string","default":"/usr/local/bin/ffmpeg"},
    {"id":"transcode_max_streams","label":"Max Simultaneous Transcodes","type":"number","default":2}
  ],
  "actions": [
    {"id":"scan","label":"Scan Decypharr","description":"Scan Decypharr API and update the VOD library.","button_label":"Scan Now","button_variant":"filled","button_color":"blue"},
    {"id":"repair","label":"Repair Integration","description":"Repair native VOD hooks and the synthetic account.","button_label":"Repair","button_variant":"outlined","button_color":"gray"},
    {"id":"transcode_test","label":"Test Transcoding","description":"Test available hardware encoders and CPU transcoding.","button_label":"Test","button_variant":"outlined","button_color":"gray"},
    {"id":"vod_database_cleanup","label":"Clean VOD Database","description":"Delete plugin VOD objects and relations and verify the VOD tables are clean.","button_label":"Clean + Verify","button_variant":"outlined","button_color":"red"}
  ]
}
